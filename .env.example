# ==============================================================================
# VARIÁVEIS DE AMBIENTE PARA DOCKER COMPOSE — SIGAD FCJA
# Copie este arquivo para ".env" na raiz do projeto caso deseje customizar portas
# ou senhas no servidor local da Fundação Casa de José Américo.
# ==============================================================================

# 1. PORTAS EXPOSTAS NA REDE LOCAL DA FUNDAÇÃO
# Porta principal do Gateway Nginx (8085 evita conflito caso o AtoM já use a porta 80 no host)
FCJA_GATEWAY_PORT=8085
# Porta direta do Frontend Web
FCJA_FRONTEND_PORT=8080
# Porta direta da API Backend FastAPI
FCJA_BACKEND_PORT=8000

# 2. CREDENCIAIS DO BANCO DE DADOS MYSQL 8.0 (CONTAINER db)
FCJA_DB_NAME=fcja_ged
FCJA_DB_USER=fcja_user
FCJA_DB_PASS=fcja_senha_segura_2026
FCJA_DB_ROOT_PASS=fcja_root_segura_2026

# 3. ORIGENS EXTRAS DE CORS (Opcional, separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://192.168.1.115,http://192.168.1.110:8085,http://ged.fcja.local

# 4. INTEGRAÇÃO ARCHIVEMATICA 1.18.0 & STORAGE SERVICE (REDE LOCAL FCJA)
FCJA_ARCHIVEMATICA_URL=http://192.168.1.132
FCJA_STORAGE_SERVICE_URL=http://192.168.1.132:8000
FCJA_ATOM_URL=http://192.168.1.110
FCJA_ARCHIVEMATICA_SHARED_DIR=/var/archivematica/sharedDirectory/watchedDirectories/activeTransfers/standardTransfer
