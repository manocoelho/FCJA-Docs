[Unit]
Description=FCJA Docs - Backend API (FastAPI + Gunicorn/Uvicorn)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
UMask=0002
WorkingDirectory=/opt/fcja-docs/backend
Environment="PATH=/opt/fcja-docs/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/opt/fcja-docs/backend/.env

# Execução em Produção com Gunicorn gerenciando workers Uvicorn
ExecStart=/opt/fcja-docs/backend/.venv/bin/gunicorn main:app \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -

# Alternativa apenas com Uvicorn (caso prefira processo único):
# ExecStart=/opt/fcja-docs/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fcja-ged-backend

[Install]
WantedBy=multi-user.target
