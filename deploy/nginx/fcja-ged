# ==============================================================================
# CONFIGURAÇÃO DE PROXY REVERSO NGINX - FCJA DOCS
# Destino no Ubuntu: /etc/nginx/sites-available/fcja-ged
# ==============================================================================

server {
    listen 80;
    listen [::]:80;

    # Aceita requisições por qualquer IP da rede local (ex: 192.168.1.X) ou domínio interno
    server_name _;

    # Permite upload de documentos de até 50MB (o limite do GED é 25MB; o padrão do Nginx é apenas 1MB)
    client_max_body_size 50M;

    # Logs dedicados para auditoria e diagnóstico do GED
    access_log /var/log/nginx/fcja-ged-access.log;
    error_log  /var/log/nginx/fcja-ged-error.log;

    # 1. Rota da API Backend (FastAPI / Gunicorn na porta 8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts estendidos para upload/leitura de planilhas e documentos grandes
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # 2. Rota de Download e Visualização Dinâmica de Arquivos Físicos do GED
    location /arquivos/ {
        proxy_pass http://127.0.0.1:8000/arquivos/;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Documentação interativa da API (Swagger/OpenAPI opcional)
    location /docs {
        proxy_pass http://127.0.0.1:8000/docs;
        proxy_set_header Host $http_host;
    }

    location /openapi.json {
        proxy_pass http://127.0.0.1:8000/openapi.json;
        proxy_set_header Host $http_host;
    }

    # 4. Rota Raiz (/) -> Frontend React/Vite/Bun (rodando internamente na porta 8080)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Suporte a WebSockets (HMR / conexões persistentes)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
