# ============================================================================
# MODELO DE CONFIGURAÇÕES DE AMBIENTE (.env.example) - FCJA DOCS
# ============================================================================

# String de conexão SQLAlchemy (MySQL via driver PyMySQL)
DATABASE_URL=mysql+pymysql://ged_admin:fcja_ged_2026@localhost:3306/fcja_ged?charset=utf8mb4

# Permite fallback automático para SQLite caso o MySQL não esteja ativo em ambiente local de teste
FCJA_ALLOW_SQLITE_FALLBACK=true

# Diretório de armazenamento físico dos documentos (Opcional - usa /var/lib/fcja_dados no Linux)
# FCJA_PASTA_DADOS=/var/lib/fcja_dados

# Origens extras permitidas no CORS (separadas por vírgula, opcional)
# CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080,http://ged.fcja.local
